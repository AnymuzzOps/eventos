# Copia este archivo como .env solo para tu herramienta local de carga de entorno.
# No uses valores reales aquí ni confirmes el archivo .env.
TAVILY_API_KEY=
GROQ_API_KEY=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Ventana y enfoque de búsqueda (no son secretos).
EVENT_START_DATE=2026-08-01
EVENT_END_DATE=2026-08-31
EVENT_CITY=Santiago
EVENT_REGION=Región Metropolitana
ONLY_FREE=true
COUPLE_MODE=true
MAX_EVENTS_PER_RUN=20

# true imprime los mensajes sin contactar Telegram.
DRY_RUN=true
# true permite reenviar resultados que ya figuran en el historial.
FORCE_RESEND=false
